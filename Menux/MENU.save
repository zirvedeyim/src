if (ImGui::Button("PC VIEW")) {
    JRMemoryEngine engine = JRMemoryEngine(mach_task_self());
    AddrRange range = (AddrRange){0x100000000, 0x2000000000};
    
    // البحث عن القيمة الأولى
    uint64_t search1 = 4853754498398552064;
    engine.JRScanMemory(range, &search1, JR_Search_Type_ULong);
    
    // البحث عن القيمة الثانية
    uint64_t search2 = 4884256341737799680;
    engine.JRScanMemory(range, &search2, JR_Search_Type_ULong);
    
    vector<void*> results = engine.getAllResults();
    uint64_t modify = 5302743970099999999;
    
    for (void* result : results) {
        if (result != nullptr) {
            engine.JRWriteMemory(reinterpret_cast<unsigned long long>(result), &modify, JR_Search_Type_ULong);
        }
    }
}

