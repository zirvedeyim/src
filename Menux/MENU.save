// ============= عناصر التحكم المعدلة =============
// CheckBox
// إعدادات الألوان المتناسقة مع اللون الأسود
colors[ImGuiCol_FrameBg]        = ImVec4(0.10f, 0.10f, 0.10f, 1.00f);  // خلفية داكنة جداً (قريبة من الأسود)
