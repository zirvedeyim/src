colors[ImGuiCol_TabUnfocused]   = ImVec4(0.05f, 0.05f, 0.05f, 1.00f);  // تبويب غير مركز
colors[ImGuiCol_TabUnfocusedActive] = ImVec4(0.1f, 0.1f, 0.1f, 1.00f); // تبويب نشط غير مركز

// ============= العناوين المعدلة =============
colors[ImGuiCol_Header]         = ImVec4(0.0f, 0.35f, 0.2f, 1.00f);   // خلفية العنوان
colors[ImGuiCol_HeaderHovered]  = ImVec4(0.0f, 0.5f, 0.3f, 1.00f);     // عنوان عند التمرير
colors[ImGuiCol_HeaderActive]   = ImVec4(0.0f, 0.7f, 0.4f, 1.00f);     // عنوان عند النقر

// ============= إعدادات النمط المعدلة =============
style.FramePadding       = ImVec2(16, 10);
