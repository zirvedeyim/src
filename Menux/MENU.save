style.PopupRounding      = 10.0f;
style.WindowBorderSize   = 4.0f;
style.FrameBorderSize    = 0.0f;
style.PopupBorderSize    = 1.0f;

// ============= ألوان إضافية معدلة =============
colors[ImGuiCol_TitleBg]          = ImVec4(0.08f, 0.08f, 0.08f, 1.00f);
colors[ImGuiCol_TitleBgActive]    = ImVec4(0.1f, 0.1f, 0.1f, 1.00f);
colors[ImGuiCol_TitleBgCollapsed] = ImVec4(0.08f, 0.08f, 0.08f, 0.75f);
colors[ImGuiCol_MenuBarBg]        = ImVec4(0.12f, 0.12f, 0.12f, 0.50f); // شفافية 50%
colors[ImGuiCol_ScrollbarBg]      = ImVec4(0.08f, 0.08f, 0.08f, 1.00f);
colors[ImGuiCol_ScrollbarGrab]    = ImVec4(0.0f, 0.3f, 0.2f, 0.60f);
colors[ImGuiCol_ScrollbarGrabHovered] = ImVec4(0.0f, 0.4f, 0.25f, 0.80f);
colors[ImGuiCol_ScrollbarGrabActive] = ImVec4(0.0f, 0.5f, 0.3f, 1.00f);
colors[ImGuiCol_Separator]        = ImVec4(0.0f, 0.3f, 0.2f, 0.50f);
colors[ImGuiCol_SeparatorHovered] = ImVec4(0.0f, 0.4f, 0.25f, 0.60f);
colors[ImGuiCol_SeparatorActive]  = ImVec4(0.0f, 0.5f, 0.3f, 0.70f);
colors[ImGuiCol_ResizeGrip]       = ImVec4(0.0f, 0.3f, 0.2f, 0.30f);
colors[ImGuiCol_ResizeGripHovered] = ImVec4(0.0f, 0.4f, 0.25f, 0.60f);
colors[ImGuiCol_ResizeGripActive] = ImVec4(0.0f, 0.5f, 0.3f, 0.90f);
colors[ImGuiCol_NavHighlight]     = ImVec4(0.0f, 0.5f, 0.3f, 1.00f);

    ImGuiIO& io = ImGui::GetIO();
    ImGui::SetNextWindowSize(ImVec2(1420, 1050), ImGuiCond_FirstUseEver); // زيادة الحجم
    ImGui::SetNextWindowPos(ImVec2(io.DisplaySize.x * 0.5f, io.DisplaySize.y * 0.5f), 0, ImVec2(0.5, 0.5f));

    if (ImGui::Begin(make_string("INOY iOS IOSSSS </>").c_str(), &self.moduleControl->menuStatus, ImGuiWindowFlags_NoCollapse)) {
        ImGui::Separator();

        // اللوحة الجانبية: قائمة بسيطة بدون تمييز دائم
        static int current_tab = 0;

// Set up the main content area (taking full window width minus tab bar height)
ImGui::SetNextWindowPos(ImVec2(0, 80));  // Start below the tab bar
ImGui::Begin("MainContent", nullptr, 
    ImGuiWindowFlags_NoTitleBar | 
    ImGuiWindowFlags_NoMove | 
    ImGuiWindowFlags_NoResize);

// Your main content goes here
// ...

ImGui::End();

// Create the vertical tab bar at top right
ImGui::SetNextWindowPos(ImVec2(ImGui::GetIO().DisplaySize.x - 270, 0));  // Right-aligned
ImGui::SetNextWindowSize(ImVec2(270, ImGui::GetIO().DisplaySize.y));
ImGui::Begin("RightSideTabs", nullptr, 
    ImGuiWindowFlags_NoTitleBar | 
    ImGuiWindowFlags_NoResize | 
    ImGuiWindowFlags_NoMove | 
    ImGuiWindowFlags_NoScrollbar);

// Tab styling
ImGui::PushStyleVar(ImGuiStyleVar_FrameRounding, 22.0f);
ImGui::PushStyleVar(ImGuiStyleVar_FramePadding, ImVec2(20, 15));
ImGui::PushStyleVar(ImGuiStyleVar_ItemSpacing, ImVec2(0, 15));

// Background for tab bar
ImGui::PushStyleColor(ImGuiCol_WindowBg, ImVec4(0.12f, 0.12f, 0.12f, 1.00f));

// All tabs in vertical layout with size 180x80
const ImVec2 tabSize(220, 120);
if (ImGui::Button("Main", tabSize)) { current_tab = -1; }
if (ImGui::Button("ESP", tabSize)) { current_tab = 0; }
if (ImGui::Button("Loot", tabSize)) { current_tab = 1; }
if (ImGui::Button("Aim", tabSize)) { current_tab = 2; }
if (ImGui::Button("Skin", tabSize)) { current_tab = 3; }
if (ImGui::Button("Memory", tabSize)) { current_tab = 4; }
if (ImGui::Button("Settings", tabSize)) { current_tab = 5; }
//if (ImGui::Button("Movement", tabSize)) { current_tab = 6; }

// Highlight active tab
if (current_tab >= -1) {
    const char* active_tab_name = "";
    switch(current_tab) {
        case -1: active_tab_name = "Main"; break;
        case 0: active_tab_name = "ESP"; break;
        case 1: active_tab_name = "Loot"; break;
        case 2: active_tab_name = "Aim"; break;
        case 3: active_tab_name = "Skin"; break;
        case 4: active_tab_name = "Memory"; break;
        case 5: active_tab_name = "Settings"; break;
        case 6: active_tab_name = "Movement"; break;
    }
    
    // Underline active tab
    if (ImGui::GetItemRectMax().x > 0) {
        ImVec2 p_min = ImGui::GetItemRectMin();
        ImVec2 p_max = ImGui::GetItemRectMax();
        p_min.y = p_max.y - 3.0f;
        ImGui::GetWindowDrawList()->AddRectFilled(
            p_min, p_max, 
            ImGui::GetColorU32(ImGuiCol_ButtonActive), 
            0.0f
        );
    }
}

// Restore styles
ImGui::PopStyleColor();
ImGui::PopStyleVar(3);
ImGui::End();

        // اللوحة الرئيسية: عرض محتوى التبويبات
        ImGui::BeginChild("Content", ImVec2(0, 0), true);
        switch (current_tab) {
            case 0: {
                ImGui::Text("Player ESP");
                ImGui::Separator();
                ImGui::Spacing();

                // تقسيم الخيارات إلى مجموعات مع أعمدة
                ImGui::Columns(2, nullptr, false);

                // العمود الأول
               
ImGui::Checkbox("Draw Line", &Line);

ImGui::SameLine();
ImGui::Checkbox("Draw Bone", &Skeleton);
                if (Skeleton) {
                    ImGui::SliderFloat("Skeleton Thickness", &skthick, 5.0f, 0.5f);
                }
                
ImGui::SameLine();
ImGui::Checkbox("Draw Info Player", &信息);
                ImGui::Checkbox("Draw Weapon", &Weapon);
                
ImGui::SameLine();
ImGui::Checkbox("Draw Box 4 Line", &Box);
                
ImGui::SameLine();
ImGui::Checkbox("Draw Box 3D", &Box2);
                ImGui::Checkbox("Draw Distance", &distancee);



ImGui::NextColumn(); // الانتقال إلى العمود الثاني

                // العمود الثاني
               

ImGui::Checkbox("Draw Health", &血条B);
                ImGui::Checkbox("Draw Alert", &Alert);
                ImGui::Checkbox("Draw Vehcle", &IsVehcle);
                ImGui::Checkbox("Draw Loot Box", &IsLootBox);
                ImGui::Checkbox("Draw Grenade Warning", &GRWAR);
                ImGui::Checkbox("Skip AI", &ESPNotBot);


                ImGui::Columns(1);

break;
                     }

            case -1: {


static bool AntiBan = false;
static float bypass_progress = 0.0f;
static bool bypass_in_progress = false;
static bool bypass_completed = false;
static std::chrono::steady_clock::time_point bypass_start_time;
static std::chrono::steady_clock::time_point last_message_time;
static int current_message_index = 0;
static float glow_effect = 0.0f;
static bool glow_increasing = true;
static float text_scale = 1.5f; // Increased text scale
static float window_alpha = 0.0f;
static float success_glow = 0.0f;
static bool success_glow_increasing = true;

// All messages to display with timings
struct BypassMessage {
    const char* text;
    int color; // 0=green, 1=red, 2=blue, 3=yellow, 4=purple
    float delay; // delay after this message
    bool bold;   // whether to display in bold
};

static const BypassMessage messages[] = {
    // English messages
    {"[SYSTEM] Initializing Bypass Sequence...", 2, 0.2f, false},
    {"[SECURITY] Bypassing PUBG MOBILE Protection...", 2, 0.25f, false},
    {"[MODULE] Loading Anti-Cheat Modules...", 2, 0.3f, false},
    
    // Chinese messages
    {"[安全系统] 正在初始化安全绕过协议...", 1, 0.25f, false},
    {"[检测引擎] 扫描游戏内存保护...", 1, 0.3f, false},
    {"[核心] 绕过完整性检查...", 1, 0.35f, true},
    {"[加密] 解密游戏安全协议...", 1, 0.25f, false},
    {"[注入] 注入安全补丁 v1.1.0...", 4, 0.4f, true},
    {"[网络] 建立安全连接通道...", 1, 0.3f, false},
    {"[验证] 验证绕过有效性...", 1, 0.35f, false},
    {"[虚拟化] 准备虚拟执行环境...", 1, 0.25f, false},
    {"[签名] 模拟官方签名验证...", 1, 0.4f, true},
    {"[内存] 应用内存补丁...", 1, 0.3f, false},
    {"[证书] 安全证书已伪造...", 1, 0.35f, true},
    {"[反调试] 反调试保护已禁用...", 1, 0.4f, false},
    {"[HOOK] 挂钩安全函数...", 3, 0.5f, true},
    {"[完成] 所有系统检查通过!", 0, 0.6f, true}
};

static const int total_messages = sizeof(messages) / sizeof(messages[0]);

// Glow effect animation
if (glow_increasing) {
    glow_effect += 0.01f;
    if (glow_effect >= 0.5f) glow_increasing = false;
} else {
    glow_effect -= 0.01f;
    if (glow_effect <= 0.0f) glow_increasing = true;
}

// Success glow effect
if (success_glow_increasing) {
    success_glow += 0.005f;
    if (success_glow >= 0.3f) success_glow_increasing = false;
} else {
    success_glow -= 0.005f;
    if (success_glow <= 0.0f) success_glow_increasing = true;
}

// Window fade in/out effect
if ((bypass_in_progress || bypass_completed) && window_alpha < 1.0f) {
    window_alpha += 0.05f;
    if (window_alpha > 1.0f) window_alpha = 1.0f;
} else if (!bypass_in_progress && !bypass_completed && window_alpha > 0.0f) {
    window_alpha -= 0.05f;
    if (window_alpha < 0.0f) window_alpha = 0.0f;
}

// Start button with large text
ImGui::PushStyleVar(ImGuiStyleVar_FramePadding, ImVec2(15, 15));
ImGui::PushStyleVar(ImGuiStyleVar_FrameRounding, 5.0f);
ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.2f, 0.5f, 0.8f, 1.0f));
ImGui::PushStyleColor(ImGuiCol_ButtonHovered, ImVec4(0.3f, 0.6f, 0.9f, 1.0f));
ImGui::PushStyleColor(ImGuiCol_ButtonActive, ImVec4(0.1f, 0.4f, 0.7f, 1.0f));
ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(1.0f, 1.0f, 1.0f, 1.0f));

if (ImGui::Button("ACTIVATE BYPASS SYSTEM", ImVec2(-1, 60))) {
    if (!bypass_in_progress && !bypass_completed) {
        bypass_in_progress = true;
        bypass_completed = false;
        bypass_progress = 0.0f;
        bypass_start_time = std::chrono::steady_clock::now();
        last_message_time = bypass_start_time;
        current_message_index = 0;
        AntiBan = true;
    }
}

ImGui::PopStyleColor(4);
ImGui::PopStyleVar(2);

if (bypass_in_progress) {
    auto current_time = std::chrono::steady_clock::now();
    auto elapsed_time = std::chrono::duration_cast<std::chrono::milliseconds>(current_time - bypass_start_time).count();
    
    bypass_progress = static_cast<float>(elapsed_time) / 7000.0f; // Extended to 7 seconds
    
    // Show messages with individual delays
    if (current_message_index < total_messages) {
        auto time_since_last_message = std::chrono::duration_cast<std::chrono::milliseconds>(current_time - last_message_time).count();
        if (time_since_last_message >= (messages[current_message_index].delay * 1000)) {
            current_message_index++;
            last_message_time = current_time;
        }
    }
    
    if (elapsed_time >= 7000) {
        bypass_in_progress = false;
        bypass_completed = true;
        bypass_progress = 1.0f;
    }
    
    // Main console window
    ImGui::PushStyleVar(ImGuiStyleVar_Alpha, window_alpha);
    ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(15, 15));
    ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding, 5.0f);
    ImGui::PushStyleColor(ImGuiCol_ChildBg, ImVec4(0.08f, 0.08f, 0.08f, 0.95f));
    ImGui::PushStyleColor(ImGuiCol_Border, ImVec4(0.2f, 0.2f, 0.2f, 1.0f));
    ImGui::PushStyleColor(ImGuiCol_BorderShadow, ImVec4(0.0f, 0.4f, 0.8f, glow_effect));
    
    ImGui::BeginChild("BypassConsole", ImVec2(0, ImGui::GetTextLineHeight() * 16 * text_scale), true, ImGuiWindowFlags_NoScrollbar);
    
    // Header with larger text
    ImGui::PushFont(ImGui::GetIO().Fonts->Fonts[1]); // Assuming you have a larger font loaded
    ImGui::TextColored(ImVec4(0.4f, 0.8f, 1.0f, 1.0f), "PUBG MOBILE SECURITY BYPASS SYSTEM v1.1.0");
    ImGui::PopFont();
    
    ImGui::Separator();
    
    // Console content with scrolling
    ImGui::BeginChild("ConsoleContent", ImVec2(0, ImGui::GetTextLineHeight() * 12 * text_scale), false, ImGuiWindowFlags_HorizontalScrollbar);
    
    // Display messages up to current index
    for (int i = 0; i < current_message_index && i < total_messages; i++) {
        ImVec4 color;
        switch (messages[i].color) {
            case 0: color = ImVec4(0.0f, 1.0f, 0.0f, 1.0f); break; // Green
            case 1: color = ImVec4(1.0f, 0.3f, 0.3f, 1.0f); break; // Red
            case 2: color = ImVec4(0.4f, 0.8f, 1.0f, 1.0f); break; // Blue
            case 3: color = ImVec4(1.0f, 0.8f, 0.0f, 1.0f); break; // Yellow
            case 4: color = ImVec4(0.8f, 0.2f, 1.0f, 1.0f); break; // Purple
            default: color = ImVec4(1.0f, 1.0f, 1.0f, 1.0f); break;
        }
        
        if (messages[i].bold) {
            ImGui::PushFont(ImGui::GetIO().Fonts->Fonts[1]); // Bold font
        }
        
        ImGui::TextColored(color, "[%02d:%02d:%03d] %s", 
            (int)(elapsed_time/60000), 
            (int)(elapsed_time/1000)%60, 
            (int)elapsed_time%1000, 
            messages[i].text);
            
        if (messages[i].bold) {
            ImGui::PopFont();
        }
    }
    
    // Auto-scroll to bottom
    if (ImGui::GetScrollY() >= ImGui::GetScrollMaxY()) {
        ImGui::SetScrollHereY(1.0f);
    }
    
    ImGui::EndChild();
    ImGui::Separator();
    
    // Enhanced progress bar
    ImGui::PushStyleColor(ImGuiCol_FrameBg, ImVec4(0.1f, 0.1f, 0.1f, 1.0f));
    ImGui::PushStyleColor(ImGuiCol_PlotHistogram, ImVec4(0.2f, 0.6f, 1.0f, 1.0f));
    ImGui::PushStyleVar(ImGuiStyleVar_FrameRounding, 3.0f);
    ImGui::ProgressBar(bypass_progress, ImVec2(-1, 30), "");
    ImGui::PopStyleVar();
    ImGui::PopStyleColor(2);
    
    // Status text with larger font
    ImGui::PushFont(ImGui::GetIO().Fonts->Fonts[1]);
    ImGui::TextColored(ImVec4(0.7f, 0.7f, 0.7f, 1.0f), "Status: %s", 
        bypass_in_progress ? "IN PROGRESS" : "COMPLETED");
    ImGui::TextColored(ImVec4(0.7f, 0.7f, 0.7f, 1.0f), "Progress: %.1f%%", bypass_progress * 100);
    ImGui::PopFont();
    
    ImGui::EndChild();
    ImGui::PopStyleColor(3);
    ImGui::PopStyleVar(3);
}

if (bypass_completed) {
    // Success window with larger text and effects
    ImGui::PushStyleVar(ImGuiStyleVar_Alpha, window_alpha);
    ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(30, 30));
    ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding, 10.0f);
    ImGui::PushStyleColor(ImGuiCol_ChildBg, ImVec4(0.1f, 0.15f, 0.2f, 0.95f));
    ImGui::PushStyleColor(ImGuiCol_Border, ImVec4(0.0f, 0.5f, 1.0f, 0.5f));
    ImGui::PushStyleColor(ImGuiCol_BorderShadow, ImVec4(0.0f, 0.8f, 1.0f, success_glow));
    ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(1.0f, 1.0f, 1.0f, 1.0f));
    
    ImGui::BeginChild("SuccessWindow", ImVec2(0, 200), true);
    
    // Center the content
    ImGui::SetCursorPosX((ImGui::GetWindowWidth() - ImGui::CalcTextSize("BYPASS ACTIVATED SUCCESSFULLY!").x) * 0.5f);
    ImGui::PushFont(ImGui::GetIO().Fonts->Fonts[1]);
    ImGui::TextColored(ImVec4(0.0f, 1.0f, 0.0f, 1.0f), "BYPASS ACTIVATED SUCCESSFULLY!");
    ImGui::PopFont();
    
    ImGui::SetCursorPosX((ImGui::GetWindowWidth() - ImGui::CalcTextSize("安全绕过已成功激活!").x) * 0.5f);
    ImGui::PushFont(ImGui::GetIO().Fonts->Fonts[1]);
    ImGui::TextColored(ImVec4(0.4f, 0.8f, 1.0f, 1.0f), "安全绕过已成功激活!");
    ImGui::PopFont();
    
    ImGui::Dummy(ImVec2(0, 20));
    
    // Center the button with larger size
    ImGui::SetCursorPosX((ImGui::GetWindowWidth() - 200) * 0.5f);
    ImGui::PushStyleVar(ImGuiStyleVar_FramePadding, ImVec2(20, 15));
    ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.2f, 0.7f, 0.2f, 1.0f));
    ImGui::PushStyleColor(ImGuiCol_ButtonHovered, ImVec4(0.3f, 0.8f, 0.3f, 1.0f));
    ImGui::PushStyleColor(ImGuiCol_ButtonActive, ImVec4(0.1f, 0.6f, 0.1f, 1.0f));
    
    if (ImGui::Button("DONE", ImVec2(200, 60))) {
        bypass_completed = false;
        AntiBan = true;
    }
    
    ImGui::PopStyleColor(3);
    ImGui::PopStyleVar();
    
    ImGui::EndChild();
    ImGui::PopStyleColor(4);
    ImGui::PopStyleVar(3);
}

